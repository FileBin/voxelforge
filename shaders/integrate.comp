#version 450
#include "common.glsl"

layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Bodies { Body b[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.grid.w)) return;
    Body x = b[i];
    if (x.misc.y > 0.5) return;
    x.vel_m.y -= pc.prm0.y * pc.prm0.x;
    if (x.ang_i.w > 0.0 && pc.prm0.z > 0.0) {
        x.ang_i.xyz *= max(1.0 - pc.prm0.z * pc.prm0.x, 0.0);
    }
    b[i] = x;
}
