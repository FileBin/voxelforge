#version 450
#include "common.glsl"

/* Спавн и деспавн тел на устройстве (шаг 3 плана синхронизации).
 *
 * Раньше CPU на каждое событие заливал в буфер тел все 144 байта на тело
 * (10 КБ). Теперь он кладёт в очередь только изменённые тела: номер слота и
 * само тело, а раскладку по буферу делает этот проход.
 *
 * Очередь — два маленьких host-visible буфера: `slot` (номера) и `staged`
 * (сами тела, 144 байта на запись). Число записей приходит в pc.hi.w. */
layout(local_size_x = 16) in;
layout(std430, set = 0, binding = 0) buffer Slots { uint slot[]; };
layout(std430, set = 0, binding = 1) buffer Staged { Body staged[]; };
layout(std430, set = 0, binding = 2) buffer Bodies { Body b[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.hi.w)) return;
    uint s = slot[i];
    /* Ёмкость буфера тел приходит в pc.lo.w (в этом проходе lo не используется). */
    if (s >= uint(pc.lo.w)) return;
    b[s] = staged[i];
}
