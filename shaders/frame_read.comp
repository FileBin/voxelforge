#version 450
#include "common.glsl"

/* Кадровый проход без окна: то, что делает вершинный шейдер окна, но
 * результатом в буфер.
 *
 * Читает БАНК, опубликованный тактом (никаких гонок с физикой), и пишет на
 * тело его интерполированную позу: mix(prev, cur, alpha). Ровно это же
 * выражение стоит в view_mesh.vert, только там оно на вершину, а здесь на
 * тело — для замера планировщика этого достаточно: оба потока делают
 * настоящую работу над настоящими данными.
 *
 * alpha приходит в prm0.x (в такте там dt — проход кадровый, не физический). */

layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Bank { Body b[]; };
layout(std430, set = 0, binding = 1) buffer Draw { vec4 out_pos[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.grid.w)) return;
    float alpha = clamp(pc.prm0.x, 0.0, 1.0);
    vec4 p = mix(b[i].prev_pos_r, b[i].pos_r, alpha);
    out_pos[i * 2u + 0u] = p;
    out_pos[i * 2u + 1u] = b[i].quat;
}
