#version 450
#include "common.glsl"

/* Пары тетов — одна invocation на ЗАПИСЬ cell_tets[i], пара (i, j) — один раз.
 *
 * Здесь было два квадрата, и оба убраны:
 *
 * 1. Свою ячейку invocation искала бинарным поиском по префиксу `tetstart`
 *    (~17 зависимых чтений по 400-килобайтному массиву на каждую запись).
 *    Номер ячейки теперь лежит рядом с записью: `tet_fill` пишет его в
 *    `cellid[at]`, здесь он читается одним обращением.
 *
 * 2. Внешний цикл начинался с `idx`, а не с самой пары: invocation idx
 *    перебирала ВСЕ i из [idx, e), поэтому пара (i, j) просматривалась
 *    (i - s + 1) раз. Работа ячейки была O(k^3/6) вместо O(k^2/2), а каждая
 *    пара попадала в список k раз — дубликаты съедали и буфер пар, и ёмкость
 *    списков контактов. Теперь invocation делает ровно свои пары (idx, j),
 *    j > idx.
 *
 * Дедуп между ячейками — как раньше: пара испускается только в ячейке
 * минимального угла пересечения AABB пары (`canon`). Эта ячейка заведомо
 * входит в диапазон раскладки обоих тетов: оба лежат в `c`, значит c внутри
 * пересечения их диапазонов, а `canon` — нижний угол этого пересечения.
 */
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Bodies { Body b[]; };
layout(std430, set = 0, binding = 1) buffer Pool { vec4 tets[]; };
layout(std430, set = 0, binding = 2) buffer Span { uvec2 span[]; };
layout(std430, set = 0, binding = 3) buffer Starts { uint start[]; };
layout(std430, set = 0, binding = 4) buffer CellTets { uvec2 cell_tets[]; };
layout(std430, set = 0, binding = 5) buffer Pairs { uvec2 pairs[]; };
layout(std430, set = 0, binding = 6) buffer PairCount { uint pcnt[]; };
layout(std430, set = 0, binding = 7) buffer BodyAabb { vec4 baabb[]; };
/* Номер ячейки каждой записи — пишет tet_fill (binding 6 того шейдера). */
layout(std430, set = 0, binding = 8) buffer CellId { uint cellid[]; };

/* Потолок пар — ровно столько, сколько выделено под `pairs` (sim::MAX_PAIRS).
 * Раньше здесь стояло 262144 при буфере на 65536 записей: всё, что сверх,
 * писалось за границу буфера — в соседнюю раскладку сетки, — а SAT читал
 * этот мусор как пары. */
const uint MAX_PAIRS = 65536u;
/* Потолок записей раскладки — ровно размер `cell_tets`/`cellid`
 * (sim::MAX_CELL_TETS). Больше tet_fill всё равно не пишет. */
const uint MAX_CELL_TETS = 262144u;

vec3 qrot(vec4 q, vec3 v) {
    vec3 u = q.yzw;
    float w = q.x;
    vec3 t = 2.0 * cross(u, v);
    return v + w * t + cross(u, t);
}

void aabb(uint body, uint tet_in_body, out vec3 lo, out vec3 hi, out bool ok) {
    ok = false;
    Body x = b[body];
    if (tet_in_body >= span[body].y) return;
    uint idx = (span[body].x + tet_in_body) * 4u;
    vec3 v0 = qrot(x.quat, tets[idx + 0u].xyz) + x.pos_r.xyz;
    vec3 v1 = qrot(x.quat, tets[idx + 1u].xyz) + x.pos_r.xyz;
    vec3 v2 = qrot(x.quat, tets[idx + 2u].xyz) + x.pos_r.xyz;
    vec3 v3 = qrot(x.quat, tets[idx + 3u].xyz) + x.pos_r.xyz;
    lo = min(min(v0, v1), min(v2, v3));
    hi = max(max(v0, v1), max(v2, v3));
    ok = true;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    /* Записей не больше MAX_CELL_TETS, групп столько же — лишние выходят. */
    uint total = start[uint(pc.grid.x * pc.grid.y * pc.grid.z)];
    if (idx >= total) return;

    uint c = cellid[idx]; /* O(1): ячейку записал tet_fill */
    /* Потолок записей — как у tet_fill: если раскладка переполнена, хвост
     * ячейки в буфер не попал, и читать его нельзя (это был бы выход за
     * буфер, то есть GPUVM fault на RADV). */
    uint e = min(start[c + 1u], MAX_CELL_TETS);
    /* Дальше в ячейке записей нет — пар у этой не будет. */
    if (idx + 1u >= e) return;

    ivec3 dims = pc.grid.xyz;
    float cell = pc.prm1.w;
    vec3 lo_box = pc.lo.xyz;
    /* Диагностика (VF_PAIR_STATS=1): счётчики в pcnt[1..]. Выключены — ноль
     * работы: одна униформа на invocation. */
    bool dbg = pc.hi.w > 0.5;
    if (dbg) {
        atomicAdd(pcnt[1], e - idx); /* сколько пар рассмотрит эта запись */
        atomicMax(pcnt[2], e - start[c]);
    }

    uvec2 A = cell_tets[idx];
    uint ta = A.y - span[A.x].x;
    vec3 alo, ahi;
    bool oka;
    aabb(A.x, ta, alo, ahi, oka);
    vec3 alo_p = baabb[A.x * 2u].xyz, ahi_p = baabb[A.x * 2u + 1u].xyz;
    vec3 inflA = abs(b[A.x].vel_m.xyz) * pc.prm0.x;
    ivec3 ca = clamp(ivec3(floor((alo - inflA - lo_box) / cell)), ivec3(0), dims - ivec3(1));

    for (uint j = idx + 1u; j < e; j++) {
        uvec2 B = cell_tets[j];
        /* Теты одного тела не сталкиваются между собой. */
        if (A.x == B.x) continue;
        if (dbg) atomicAdd(pcnt[6], 1u);
        /* Префильтр по AABB тел: 6 сравнений отсекают тела, которые лишь
         * делят клетку сетки, но разъехались по пространству. */
        vec3 blo_p = baabb[B.x * 2u].xyz, bhi_p = baabb[B.x * 2u + 1u].xyz;
        if (any(greaterThan(alo_p, bhi_p)) || any(greaterThan(blo_p, ahi_p))) continue;

        uint tb = B.y - span[B.x].x;
        vec3 blo, bhi;
        bool okb;
        aabb(B.x, tb, blo, bhi, okb);
        if (!oka || !okb) continue;
        vec3 inflB = abs(b[B.x].vel_m.xyz) * pc.prm0.x;
        /* AABB тетов не пересекаются ДАЖЕ с запасом на путь за такт — SAT всё
         * равно нашёл бы разделяющую ось по координате, пара физически не
         * может дать контакт. Запас тот же, что у раскладки по ячейкам
         * (|v|·dt), поэтому быстрый снаряд свои пары не теряет. В плотной
         * ячейке (десятки тетов разных тел) это отсекает почти всё. */
        if (any(greaterThan(alo - inflA, bhi + inflB)) ||
            any(greaterThan(blo - inflB, ahi + inflA))) continue;
        ivec3 cb = clamp(ivec3(floor((blo - inflB - lo_box) / cell)), ivec3(0), dims - ivec3(1));
        ivec3 canon3 = max(ca, cb);
        int canon = (canon3.z * dims.y + canon3.y) * dims.x + canon3.x;
        if (uint(canon) != c) continue;

        if (dbg) atomicAdd(pcnt[5], 1u);
        uint k = atomicAdd(pcnt[0], 1u);
        if (k < MAX_PAIRS) {
            pairs[k] = uvec2((A.x << 20) | ta, (B.x << 20) | tb);
        } else if (dbg) {
            atomicAdd(pcnt[7], 1u); /* сколько пар не влезло в буфер */
        }
    }
}
