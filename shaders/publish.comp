#version 450
#include "common.glsl"

/* Публикация состояния в БАНК КАДРА.
 *
 * Такт считает тела в своих буферах (они ping-pong'ают между итерациями
 * солвера), а кадр не должен читать ни один из них: буфер, который GPU прямо
 * сейчас переписывает, читать нельзя — это и был GPUVM fault первой попытки
 * двух очередей (кадр читал состояние посреди такта).
 *
 * Поэтому такт последним проходом копирует тела в банк (tick % 2) и
 * сигналит таймлайн «такт N опубликован». Кадр ждёт это значение и читает
 * другой банк. Пока кадр читает банк 0, такт может писать в банк 1 — они
 * физически разные буферы.
 *
 * prev_pos_r/prev_quat в теле — поза на начало такта: кадр интерполирует от
 * неё, поэтому копируется тело ЦЕЛИКОМ, а не только текущая поза. */

layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Src { Body a[]; };
layout(std430, set = 0, binding = 1) buffer Dst { Body b[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.grid.w)) return;
    b[i] = a[i];
}
