#version 450
#include "common.glsl"

layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Bodies { Body b[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.grid.w)) return;
    Body x = b[i];
    if (x.misc.y > 0.5) return;
    float dt = pc.prm0.x;
    x.pos_r.xyz += x.vel_m.xyz * dt;

    vec3 w = x.ang_i.xyz;
    if (dot(w, w) > 0.0) {
        vec4 q = x.quat;
        vec3 h = w * (0.5 * dt);
        /* (0,h) ⊗ q = (-h·q.xyz, q.w·h + h × q.xyz) */
        vec4 dq = vec4(-dot(h, q.yzw), q.x * h + cross(h, q.yzw));
        q += dq;
        x.quat = normalize(q);
    }
    b[i] = x;
}
