#version 450
#include "common.glsl"

/* Скоростное решение контактов, Jacobi по телам.
 *
 * Каждое тело решает СВОЮ сторону контакта, читая партнёра из снимка
 * (bin). Оба тела пары считают один и тот же импульс, потому что входные
 * данные одинаковые, — значит в сумме пара получает ровно полный импульс,
 * как в обычном последовательном солвере, но без гонок и без атомиков.
 * Плата — сходимость медленнее Gauss-Seidel, поэтому итераций больше.
 */
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer BodiesIn { Body bin[]; };
layout(std430, set = 0, binding = 1) buffer Lists { C list[]; };
layout(std430, set = 0, binding = 2) buffer ListCount { uint lc[]; };
layout(std430, set = 0, binding = 3) buffer BodiesOut { Body bout[]; };

/* Импульсы теперь делятся на число контактов (см. inv ниже), поэтому сумма
 * больше не перебирает: демпфер 0.5, который гасил перебор, только
 * недокручивал кучу. 0.85 — лёгкая страховка на случай разнонаправленных
 * контактов. */
const float RELAX = 0.85;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.grid.w)) return;

    Body me = bin[i];
    if (me.misc.y > 0.5) { bout[i] = me; return; }
    vec3 v = me.vel_m.xyz;
    vec3 w = me.ang_i.xyz;
    float im = me.vel_m.w;
    float ii = me.ang_i.w;
    vec3 my_half = me.half_shape.xyz;
    float dt = pc.prm0.x;
    float mu = pc.prm0.w;

    uint n = lc[i];
    if (n > uint(CAP)) n = uint(CAP);

    /* Импульсы считаются от СНИМКА (v, w) и копятся отдельно, а применяются
     * один раз в конце. Это принципиально: если применять их по ходу обхода,
     * тело решает контакты в фиксированном пространственном порядке, и обход
     * превращается в храповик — кучу систематически сносит к одной стенке
     * (проверено: разворот порядка обхода разворачивал снос). */
    vec3 dv = vec3(0.0);
    vec3 dw = vec3(0.0);

    for (uint k = 0u; k < n; k++) {
        C c = list[i * CAP + k];
        int j = c.meta.x;
        vec3 nrm = c.n_pen.xyz;
        float pen = c.n_pen.w;

        vec3 ov = vec3(0.0);
        vec3 ow = vec3(0.0);
        float oim = 0.0;
        vec3 o_half = vec3(0.0);
        float oii = 0.0;
        vec3 opos = vec3(0.0);
        if (j >= 0) {
            Body o = bin[j];
            opos = o.pos_r.xyz;
            ov = o.vel_m.xyz;
            ow = o.ang_i.xyz;
            oim = o.vel_m.w;
            o_half = o.half_shape.xyz;
            oii = o.ang_i.w;
        }

        /* Плечо — от центра тела до НАСТОЯЩЕЙ точки контакта из SAT.
         * Раньше здесь стояло n * half_shape, и тело вело себя как сфера
         * в ориджине: квадратный осколок катился по полу, а снаряд проходил
         * сквозь края. Точка приходит от CPU, где считается пересечение
         * тетраэдров. */
        vec3 rself = c.point.xyz - me.pos_r.xyz;
        vec3 rother = c.point.xyz - opos;
        bool is_static = (j < 0);
        vec3 vrel = is_static
            ? (v + cross(w, rself))
            : (ov + cross(ow, rother)) - (v + cross(w, rself));
        float vn = dot(vrel, nrm);
        /* Угловая часть в знаменателе НОРМАЛЬНОГО импульса. Без неё импульс
         * в точке далеко от центра (угол коробки) считался так, будто тело
         * не может повернуться: dl выходил больше нужного, тело получало
         * лишний момент и качалось на грани. У осколков точка контакта
         * ближе к центру, поэтому они и страдали меньше. */
        vec3 ra_n = cross(rself, nrm);
        vec3 rb_n = cross(rother, nrm);
        float wn = im + oim + dot(ra_n, ra_n) * ii + dot(rb_n, rb_n) * oii;
        if (wn <= 0.0) continue;
        float sgn = is_static ? 1.0 : -1.0;

        /* pen < 0 — спекулятивный контакт от SAT: тела ещё не коснулись.
         * Разрешаем сближаться ровно настолько, чтобы закрыть зазор за этот
         * подшаг. Иначе быстрый снаряд проскакивает цель между подшагами. */
        float push = (pen < 0.0)
            ? -pen / dt
            : min(max(pen - pc.prm1.z, 0.0) * pc.prm1.x / dt, pc.prm1.y);
        /* Только отталкивание. Отрицательный импульс (пара уже разлетается
         * быстрее, чем требует bias) физически означает ПРИТЯЖЕНИЕ; в плотном
         * клубке осколков такие пары раскачивали друг друга и за один кадр
         * разгоняли тела до километров в секунду. */
        /* Импульсы со ВСЕХ контактов копятся от одного снимка скорости, а
         * значит каждый контакт «не знает» про остальные и требует полной
         * коррекции. У тела с четырьмя точками опоры сумма выходила вчетверо
         * больше нужного, и цельная плита подпрыгивала вверх (у мелких
         * осколков точек мало, поэтому они вели себя нормально). Делим на
         * число контактов — по большему из двух тел пары, чтобы обе стороны
         * считали одинаково и импульс пары оставался симметричным. */
        uint nj = (j >= 0) ? min(lc[j], uint(CAP)) : 1u;
        float inv = 1.0 / float(max(max(n, 1u), max(nj, 1u)));
        float dl = max(push - vn, 0.0) / wn * inv;
        vec3 P = nrm * dl;
        dv += P * (im * sgn);
        dw += cross(rself, P) * (ii * sgn);

        /* Сопротивление качанию. В статическом контакте (есть нормальный
         * импульс, касательная скорость почти нулевая) гасим угловую скорость:
         * без этого осколок на ребре качается и не засыпает. Коэффициент
         * маленький — это не трение, а только гашение качания. */
        if (dl > 0.0 && ii > 0.0) {
            float wmag = length(w);
            vec3 vt_now = vrel - nrm * vn;
            if (wmag > 1e-3 && length(vt_now) < 0.05 && length(dv) < 0.05) {
                dw -= w * 0.1;
            }
        }

        vec3 vt_vec = vrel - nrm * vn;
        float vt = length(vt_vec);
        if (mu > 0.0 && vt > 1e-7) {
            vec3 t = vt_vec / vt;
            vec3 ra_xt = cross(rself, t);
            vec3 rb_xt = cross(rother, t);
            float wt = im + oim + dot(ra_xt, ra_xt) * ii + dot(rb_xt, rb_xt) * oii;
            if (wt > 0.0) {
                float cap = mu * max(dl, 0.0);
                float dlt = clamp(-vt / wt, -cap, cap);
                vec3 Pt = t * dlt;
                dv += Pt * (im * sgn);
                dw += cross(rself, Pt) * (ii * sgn);
            }
        }
    }

    /* Релаксация: контакты считаются независимо и в сумме перебирают
     * коррекцию (у тела их до 24). Без множителя штабель звенит. */
    v += dv * RELAX;
    w += dw * RELAX;

    if (any(isnan(v)) || any(isnan(w))) {
        /* отладка: помечаем тело, а не разносим мир молча */
        me.misc.z = -999.0;
    }
    me.vel_m = vec4(v, im);
    me.ang_i = vec4(w, ii);
    bout[i] = me;
}
