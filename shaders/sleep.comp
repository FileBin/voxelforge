#version 450
#include "common.glsl"

/* Сон: тело, которое долго не двигается, выключается из симуляции.
 *
 * Без этого куча на GPU никогда не «замирает»: остаточная скорость от bias
 * и от итераций солвера не даёт ей успокоиться, хотя визуально она стоит.
 * Пороги те же, что в CPU-эталоне: 5 см/с и 0.5 с покоя.
 */
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Bodies { Body b[]; };

const float SLEEP_LINEAR = 0.05;
const float SLEEP_TIME = 0.5;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.grid.w)) return;
    Body x = b[i];
    if (x.misc.y > 0.5) return;

    float v2 = dot(x.vel_m.xyz, x.vel_m.xyz);
    float w2 = dot(x.ang_i.xyz, x.ang_i.xyz);
    bool quiet = (v2 < SLEEP_LINEAR * SLEEP_LINEAR) && (w2 < 1.0);

    x.misc.x = quiet ? x.misc.x + pc.prm0.x : 0.0;
    if (x.misc.x >= SLEEP_TIME) {
        x.misc.y = 1.0;
        x.misc.z = x.vel_m.w;
        x.misc.w = x.ang_i.w;
        x.vel_m = vec4(0.0);
        x.ang_i = vec4(0.0);
    }
    b[i] = x;
}
