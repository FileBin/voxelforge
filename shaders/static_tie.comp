#version 450
#include "common.glsl"

/* Контакты со статикой, проход 2 из 4: выбор победителя по каждому каналу.
 *
 * static_work уже свёл максимумы в score[] через atomicMax. Здесь каждый тет,
 * чей локальный максимум РАВЕН глобальному, метит себя атомарным минимумом в
 * win[]. Так побеждает минимальный индекс тета — ровно то, что делал
 * последовательный цикл «первый максимум по (тет, вершина)»; поэтому выбор
 * детерминирован и не зависит от порядка выполнения групп.
 *
 * Отдельный проход нужен именно из-за равенства: сравнение float-битов здесь
 * точное, никакой потери мантиссы, как было бы при упаковке «счётчик + индекс»
 * в один atomicMax.
 */

layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer Span { uvec2 span[]; };
layout(std430, set = 0, binding = 1) readonly buffer Work { uint work[]; };
layout(std430, set = 0, binding = 2) readonly buffer Cand { uint cand[]; };
layout(std430, set = 0, binding = 3) readonly buffer Score { uint score[]; };
layout(std430, set = 0, binding = 4) buffer Win { uint win[]; };

const uint TAIL = 0xFFFFFFFFu;

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint w = work[i];
    if (w == TAIL) return;

    uint bi = w >> 16;
    uint t = w & 0xFFFFu;
    uint g = span[bi].x + t; /* индекс тета в общем пуле — он и есть порядок */
    uint o = i * 8u;
    uint slot = bi * 8u;

    for (int c = 0; c < 8; c++) {
        uint k = cand[o + uint(c)];
        if (k == 0u) continue;
        if (k != score[slot + uint(c)]) continue;
        atomicMin(win[slot + uint(c)], g);
    }
}
