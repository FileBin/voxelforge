#version 450
#include "common.glsl"

layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Counts { uint cnt[]; };
layout(std430, set = 0, binding = 1) buffer Cells { uint cellcnt[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint nb = uint(pc.grid.w);
    uint nc = uint(pc.grid.x * pc.grid.y * pc.grid.z);
    if (i < nb) cnt[i] = 0u;
    if (i < nc) cellcnt[i] = 0u;
}
