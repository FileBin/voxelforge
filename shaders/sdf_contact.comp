#version 450
#include "common.glsl"

/* Контакты SDF↔SDF — перенос CPU-оракула crates/world/src/sdf_contact.rs.
 *
 * Что считается (и почему так):
 *   1. ЗАТРАВКИ — узлы сетки тела с БОЛЕЕ МЕЛКИМ шагом поля, рядом с чужим
 *      AABB. Годен узел, где `fs + ft < marg`: сумма ЗНАКОВЫХ расстояний до
 *      двух поверхностей — это зазор между телами в этой точке (минус внутри
 *      пересечения). Прежнее условие «оба поля < 0» требовало, чтобы узел лежал
 *      ВНУТРИ обоих тел: у шара r=0.14 внутри ровно один узел (центр), он
 *      попадал внутрь партнёра только при перекрытии на радиус — на 20 м/с
 *      (0.125 м за подшаг) аппарат пролетал это окно за один подшаг, пар 3,
 *      контактов 0, реакции нет («тела проходят сквозь друга»).
 *   2. МАРЖА `marg = шаг узла + относительный путь за подшаг`. Путь нужен,
 *      чтобы пара находилась ДО удара; шаг — потому что затравки дискретны.
 *   3. СПУСК 4 итерации `p -= 0.5*(f_a*n_a + f_b*n_b)` — к паре ближайших
 *      точек поверхностей. Шаг ограничен половиной шага узла.
 *   4. Глубина ЗНАКОВАЯ: `-(va + vb)` — плюс внутри, минус в зазоре. Минус —
 *      законный СПЕКУЛЯТИВНЫЙ контакт: солвер по нему разрешает сближение
 *      ровно на зазор (solve_contacts.comp, ветка pen<0).
 *   5. ОДНА НОРМАЛЬ НА ПАРУ — нормаль самого глубокого контакта. Иначе у шара,
 *      утопленного в плиту, два десятка точек «шапки» дают каждая свою
 *      наклонную нормаль, моменты не сокращаются, и шар раскручивается от
 *      вертикального удара (измерено: спин −11.8 рад/с, дальше нормализация
 *      кватерниона и NaN). SAT по той же причине берёт ОДНУ ось на пару.
 *
 * Раскладка буферов — как раньше (sim.rs GpuSim::upload_sdf): тела,
 * дескрипторы полей, значения полей, пары тел, список контактов, счётчики.
 * Контакты пишутся в ТОТ ЖЕ список, что заполняет sat.comp, поэтому
 * contact_select / impact / depenetrate / солвер не меняются.
 */
layout(local_size_x = 64) in;

/* Слов на слот в пуле значений (sim::SDF_STRIDE). */
const uint SDF_STRIDE = 65536u;
/* Затравок на пару: одна рабочая группа, каждому потоку — свой кусок сетки. */
const uint SEEDS = 64u;

layout(std430, set = 0, binding = 0) buffer Bodies { Body b[]; };
layout(std430, set = 0, binding = 1) readonly buffer Descs { SdfDesc descs[]; };
layout(std430, set = 0, binding = 2) readonly buffer Values { float vals[]; };
layout(std430, set = 0, binding = 3) readonly buffer Pairs { uvec2 pairs[]; };
layout(std430, set = 0, binding = 4) buffer Lists { C list[]; };
layout(std430, set = 0, binding = 5) buffer ListCount { uint lc[]; };
layout(std430, set = 0, binding = 6) readonly buffer PairCount { uint pcnt[]; };

/* Общая нормаль пары: зазор и нормаль самого глубокого контакта. */
shared float s_gap[SEEDS];
shared vec3 s_nrm[SEEDS];

vec3 qrot(vec4 q, vec3 v) {
    vec3 u = q.yzw;
    float w = q.x;
    vec3 t = 2.0 * cross(u, v);
    return v + w * t + cross(u, t);
}

vec3 qinv_rot(vec4 q, vec3 v) { return qrot(vec4(q.x, -q.yzw), v); }

ivec3 dims_of(SdfDesc d) { return sdf_dims(d); }

/* Шаг узла для маржи: сетка затравок — по более мелкому полю. */
float ds_step(SdfDesc da, SdfDesc db) { return min(da.step_pad.x, db.step_pad.x); }

/* узел (в координатах узлов) → мир */
vec3 node_to_world(Body bd, SdfDesc d, vec3 n) {
    return qrot(bd.quat, d.shift.xyz + n * d.step_pad.x) + bd.pos_r.xyz;
}

/* мир → узел (дробный, для трилинейной выборки) */
vec3 world_to_node(Body bd, SdfDesc d, vec3 w) {
    return (qinv_rot(bd.quat, w - bd.pos_r.xyz) - d.shift.xyz) / d.step_pad.x;
}

/* значение в узле: индексы локальные (n - lo), край — зажим, как в
 * NodeField::at на CPU */
float at_node(SdfDesc d, uint base, ivec3 n) {
    ivec3 dm = dims_of(d);
    ivec3 c = clamp(n, ivec3(0), dm - 1);
    uint i = (uint(c.z) * uint(dm.y) + uint(c.y)) * uint(dm.x) + uint(c.x);
    return vals[base + i];
}

/* трилинейная выборка в координатах узлов (абсолютных, с lo) */
float sample_node(SdfDesc d, uint base, vec3 n) {
    vec3 p = n - vec3(d.lo_dims.xyz);
    vec3 f = floor(p);
    vec3 t = p - f;
    ivec3 i = ivec3(f);
    float v000 = at_node(d, base, i + ivec3(0, 0, 0));
    float v100 = at_node(d, base, i + ivec3(1, 0, 0));
    float v010 = at_node(d, base, i + ivec3(0, 1, 0));
    float v110 = at_node(d, base, i + ivec3(1, 1, 0));
    float v001 = at_node(d, base, i + ivec3(0, 0, 1));
    float v101 = at_node(d, base, i + ivec3(1, 0, 1));
    float v011 = at_node(d, base, i + ivec3(0, 1, 1));
    float v111 = at_node(d, base, i + ivec3(1, 1, 1));
    float a = mix(mix(v000, v100, t.x), mix(v010, v110, t.x), t.y);
    float c = mix(mix(v001, v101, t.x), mix(v011, v111, t.x), t.y);
    return mix(a, c, t.z);
}

/* градиент в координатах узлов — нормаль изоповерхности в системе тела */
vec3 gradient_node(SdfDesc d, uint base, vec3 p) {
    const float h = 0.5;
    float gx = sample_node(d, base, p + vec3(h, 0, 0)) - sample_node(d, base, p - vec3(h, 0, 0));
    float gy = sample_node(d, base, p + vec3(0, h, 0)) - sample_node(d, base, p - vec3(0, h, 0));
    float gz = sample_node(d, base, p + vec3(0, 0, h)) - sample_node(d, base, p - vec3(0, 0, h));
    return normalize(vec3(gx, gy, gz) + vec3(1e-9));
}

void push_contact(uint self, uint other, vec3 p, vec3 n, float depth) {
    C c;
    c.meta = ivec4(int(other), 0, 0, 0);
    c.n_pen = vec4(n, depth);
    c.point = vec4(p, 1.0);
    uint slot = atomicAdd(lc[self], 1u);
    if (slot < uint(CAP)) list[self * uint(CAP) + slot] = c;
}

/* Самый глубокий (наименьший зазор) контакт ЭТОГО потока. */
struct Best {
    float gap;
    vec3 p;
    vec3 n;
    bool ok;
};

Best scan(
    uint is, uint it,
    SdfDesc ds, SdfDesc dt,
    Body Bs, Body Bt,
    uint base_s, uint base_t,
    uint lane, float marg
) {
    Best best;
    best.gap = 1e30; best.p = vec3(0.0); best.n = vec3(0.0); best.ok = false;

    /* AABB партнёра в мире — из его сетки (8 углов) */
    vec3 dmax = vec3(dims_of(dt) - ivec3(1));
    vec3 tlo = vec3(1e30);
    vec3 thi = vec3(-1e30);
    for (int c = 0; c < 8; c++) {
        vec3 n = vec3(float(c & 1), float((c >> 1) & 1), float((c >> 2) & 1)) * dmax
               + vec3(dt.lo_dims.xyz);
        vec3 w = node_to_world(Bt, dt, n);
        tlo = min(tlo, w);
        thi = max(thi, w);
    }
    /* …и в систему узлов тела-затравки, пересекая с её сеткой */
    vec3 slo = vec3(1e30);
    vec3 shi = vec3(-1e30);
    for (int c = 0; c < 8; c++) {
        vec3 w = vec3((c & 1) != 0 ? thi.x : tlo.x,
                      (c & 2) != 0 ? thi.y : tlo.y,
                      (c & 4) != 0 ? thi.z : tlo.z);
        vec3 n = world_to_node(Bs, ds, w);
        slo = min(slo, n);
        shi = max(shi, n);
    }
    vec3 flo = vec3(ds.lo_dims.xyz);
    vec3 fhi = flo + vec3(dims_of(ds) - ivec3(1));
    /* пересечение РАСШИРЯЕМ на маржу: у грубых полей боксы могут не
     * пересечься даже когда поверхности уже почти касаются (два шара r=0.14 с
     * зазором 2 см: боксы полей расходятся на 4 мм — и контактов не было). */
    float mp = marg / ds.step_pad.x;
    ivec3 lo_i = ivec3(ceil(max(slo - vec3(mp), flo) - vec3(1e-3)));
    ivec3 hi_i = ivec3(floor(min(shi + vec3(mp), fhi) + vec3(1e-3)));
    if (any(greaterThan(lo_i, hi_i))) return best;

    ivec3 span = hi_i - lo_i + ivec3(1);
    uint total = uint(span.x) * uint(span.y) * uint(span.z);
    /* Кусок сетки на поток — СПЛОШНОЙ (не «каждый 64-й узел»). */
    uint per = max(1u, (total + SEEDS - 1u) / SEEDS);
    uint begin = lane * per;
    uint end = min(total, begin + per);
    if (begin >= end) return best;

    uint sx = uint(span.x);
    uint sy = uint(span.y);

    for (uint k = begin; k < end; k++) {
        ivec3 ln = ivec3(int(k % sx), int((k / sx) % sy), int(k / (sx * sy)));
        ivec3 node = lo_i + ln;

        /* В МЕТРАХ: у двух тел РАЗНЫЕ шаги узла, и складывать значения в
         * узловых единицах нельзя — это была ошибка (марж сравнивался с
         * суммой разных масштабов). */
        float fs = at_node(ds, base_s, node - ds.lo_dims.xyz) * ds.step_pad.x;
        vec3 w = node_to_world(Bs, ds, vec3(node));
        float ft = sample_node(dt, base_t, world_to_node(Bt, dt, w)) * dt.step_pad.x;
        float gap0 = fs + ft;
        if (gap0 >= marg) continue;

        /* БЫСТРЫЙ ВЫХОД на глубоком перекрытии: искать «ещё глубже» в толще
         * перекрытия незачем — там десятки узлов, каждый со спуском. Достаточно
         * одного узла глубиной в шаг сетки. Это главный ограничитель цены:
         * без него проход по толще поля стоит десятки миллисекунд на пару. */
        if (gap0 <= -ds.step_pad.x) {
            if (gap0 < best.gap) {
                vec3 na0 = world_to_node(Bs, ds, w);
                vec3 nb0 = world_to_node(Bt, dt, w);
                vec3 ga0 = qrot(Bs.quat, gradient_node(ds, base_s, na0));
                vec3 gb0 = qrot(Bt.quat, gradient_node(dt, base_t, nb0));
                vec3 n0 = normalize(ga0 - gb0 + vec3(1e-9));
                if (!any(isnan(n0)) && !any(isinf(n0))) {
                    best.gap = gap0;
                    best.p = w;
                    best.n = n0;
                    best.ok = true;
                }
            }
            break;
        }

        /* спуск к паре ближайших точек поверхностей */
        vec3 p = w;
        bool bad = false;
        for (int it2 = 0; it2 < 4; it2++) {
            vec3 na = world_to_node(Bs, ds, p);
            vec3 nb = world_to_node(Bt, dt, p);
            vec3 ga = qrot(Bs.quat, gradient_node(ds, base_s, na));
            vec3 gb = qrot(Bt.quat, gradient_node(dt, base_t, nb));
            float va = sample_node(ds, base_s, na) * ds.step_pad.x;
            float vb = sample_node(dt, base_t, nb) * dt.step_pad.x;
            vec3 d = 0.5 * (va * ga + vb * gb);
            float lim = 0.5 * ds.step_pad.x;
            float len = length(d);
            if (len > lim) d *= lim / len;
            p -= d;
            if (any(isnan(p)) || any(isinf(p))) { bad = true; break; }
        }
        if (bad) continue;

        vec3 na = world_to_node(Bs, ds, p);
        vec3 nb = world_to_node(Bt, dt, p);
        vec3 ga = qrot(Bs.quat, gradient_node(ds, base_s, na));
        vec3 gb = qrot(Bt.quat, gradient_node(dt, base_t, nb));
        float va = sample_node(ds, base_s, na) * ds.step_pad.x;
        float vb = sample_node(dt, base_t, nb) * dt.step_pad.x;
        float gap = va + vb;
        /* Спуск ищет пару БЛИЖАЙШИХ точек поверхностей: у двух выпуклых тел это
         * окружность пересечения поверхностей, где сумма = 0, — а настоящая
         * глубина сидит в глубине перекрытия (у двух шаров с перекрытием 0.1 м
         * спуск даёт 0.002). Поэтому берём БОЛЬШУЮ глубину из двух: узла-затравки
         * и спущенной точки. Для «шар на плите» глубины совпадают, для
         * «шар в шар» работает затравка. */
        vec3 n_here = normalize(ga - gb + vec3(1e-9));
        if (isnan(gap) || isinf(gap) || any(isnan(n_here)) || any(isinf(n_here))) continue;
        if (gap >= marg) continue;
        if (gap < gap0) {
            if (gap < best.gap) {
                best.gap = gap;
                best.p = p;
                best.n = n_here;
                best.ok = true;
            }
        } else if (gap0 < best.gap) {
            vec3 na0 = world_to_node(Bs, ds, w);
            vec3 nb0 = world_to_node(Bt, dt, w);
            vec3 ga0 = qrot(Bs.quat, gradient_node(ds, base_s, na0));
            vec3 gb0 = qrot(Bt.quat, gradient_node(dt, base_t, nb0));
            vec3 n0 = normalize(ga0 - gb0 + vec3(1e-9));
            if (any(isnan(n0)) || any(isinf(n0))) continue;
            best.gap = gap0;
            best.p = w;
            best.n = n0;
            best.ok = true;
        }
    }
    return best;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    uint pair = id / SEEDS;
    uint lane = id % SEEDS;

    /* ВСЕ потоки группы обязаны дойти до barrier() — выход только через флаг
     * (условия ниже одинаковы для всей группы). */
    bool live = true;
    if (pair >= pcnt[0] || lane >= SEEDS) live = false;

    uint ia = 0u, ib = 0u, nbody = uint(pc.grid.w);
    if (live) {
        uvec2 pr = pairs[pair];
        ia = pr.x;
        ib = pr.y;
        if (ia >= nbody || ib >= nbody || ia == ib) live = false;
    }

    SdfDesc da, db;
    Body A, B;
    bool sleep_a = false, sleep_b = false;
    float marg = 0.0;
    bool a_seed = true;
    if (live) {
        da = descs[ia];
        db = descs[ib];
        if (!sdf_has_field(da) || !sdf_has_field(db)) live = false;
    }
    if (live) {
        A = b[ia];
        B = b[ib];
        sleep_a = A.misc.y > 0.5;
        sleep_b = B.misc.y > 0.5;
        if (sleep_a && sleep_b) live = false;
    }
    /* Маржа: шаг узла (затравки дискретны) + относительный путь за подшаг
     * (пара обязана найтись ДО удара). */
    /* Маржа: 3 шага узла (затравки дискретны, и «нуль поля» лежит между узлами)
     * + относительный путь за подшаг. Большая маржа безопасна: контакт с
     * pen<0 солвер трактует как «сближаться можно ровно на зазор», а не как
     * «стоп» — поэтому лишние спекулятивные контакты не подвешивают тело,
     * зато покоящийся контакт НЕ ПРОПАДАЕТ через такт (без этого шар дрожал
     * на месте: контакт есть через такт, скорость гуляет 0.1–0.5 м/с). */
    if (live) marg = 3.0 * ds_step(da, db) + length(A.vel_m.xyz - B.vel_m.xyz) * pc.prm0.x;
    if (live) a_seed = da.step_pad.x <= db.step_pad.x;   /* затравки — по мелкому полю */

    Best best;
    best.gap = 1e30; best.p = vec3(0.0); best.n = vec3(0.0); best.ok = false;
    if (live) {
        uint is = a_seed ? ia : ib;
        uint it = a_seed ? ib : ia;
        SdfDesc ds = a_seed ? da : db;
        SdfDesc dt = a_seed ? db : da;
        Body Bs = a_seed ? A : B;
        Body Bt = a_seed ? B : A;
        best = scan(is, it, ds, dt, Bs, Bt, is * SDF_STRIDE, it * SDF_STRIDE, lane, marg);
    }

    /* Одна нормаль на пару: нормаль САМОГО ГЛУБОКОГО контакта. */
    s_gap[lane] = best.ok ? best.gap : 1e30;
    s_nrm[lane] = best.ok ? best.n : vec3(0.0);
    barrier();

    float g0 = 1e30;
    vec3 n0 = vec3(0.0);
    for (uint k = 0u; k < SEEDS; k++) {
        float g = s_gap[k];
        if (g < g0) { g0 = g; n0 = s_nrm[k]; }
    }

    if (!live || !best.ok || g0 >= 1e30) return;

    /* Точки, далёкие от самой глубокой, не нужны: они дают момент вбок. */
    float reach = g0 + ds_step(da, db) * 2.0;
    if (best.gap > reach) return;

    /* Нормаль считалась ОТ ЗАТРАВКИ к партнёру. Солвер ждёт нормаль ОТ ТЕЛА к
     * партнёру (и по ней же берётся плечо импульса), поэтому при затравке из
     * второго тела её надо развернуть. Раньше знак не разворачивался: у пары
     * «плита (мелкая сетка) + шар» нормаль выходила НАРУЖУ, vn получалась
     * положительной, dl = max(push - vn, 0) = 0 — солвер молчал, и шар
     * проходил сквозь плиту при живых контактах в списке. */
    vec3 n_ab = a_seed ? n0 : -n0;   /* от ia к ib */
    push_contact(ia, ib, best.p, n_ab, -best.gap);
    push_contact(ib, ia, best.p, -n_ab, -best.gap);

    /* Пробуждение на месте — как в sat.comp (запись идемпотентна). */
    if (sleep_a && length(B.vel_m.xyz) > 0.35) {
        A.misc.y = 0.0;
        A.misc.x = 0.0;
        A.vel_m.w = A.misc.z;
        A.ang_i.w = A.misc.w;
        A.anchor = vec4(A.pos_r.xyz, 0.0);
        b[ia] = A;
    }
    if (sleep_b && length(A.vel_m.xyz) > 0.35) {
        B.misc.y = 0.0;
        B.misc.x = 0.0;
        B.vel_m.w = B.misc.z;
        B.ang_i.w = B.misc.w;
        B.anchor = vec4(B.pos_r.xyz, 0.0);
        b[ib] = B;
    }
}
