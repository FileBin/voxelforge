#version 450
#include "w_push.glsl"

layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Pos { vec4 pos[]; };
layout(std430, set = 0, binding = 1) buffer Prev { vec4 prev[]; };
layout(std430, set = 0, binding = 2) buffer Vel { vec4 vel[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(wp.prm2.x)) return;
    float dt = wp.prm0.x;
    vec4 p = pos[i];
    prev[i] = p;
    vec3 v = vel[i].xyz + vec3(0.0, -9.81, 0.0) * dt;
    vel[i] = vec4(v, 0.0);
    pos[i] = vec4(p.xyz + v * dt, p.w);
}
