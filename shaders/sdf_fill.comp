#version 450
/* Заполнение сетки SDF аналитическим примитивом — целиком на устройстве.
 *
 * Один поток на узел сетки: считает точное евклидово расстояние до поверхности
 * примитива (со знаком: внутри минус, снаружи плюс) и пишет в буфер.
 * Это первый путь создания объектов: CPU только задаёт примитив и размеры
 * сетки, дальше данные рождаются на видеокарте.
 */
layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Out {
    float d[];
};

layout(push_constant) uniform PC {
    uvec4 grid;    // nx, ny, nz, вид примитива
    vec4 origin;   // x, y, z, шаг сетки
    vec4 a;        // центр.xyz, радиус (для шара/капсулы/цилиндра)
    vec4 b;        // полуразмеры.xyz (коробка); b.x — полувысота цилиндра
    vec4 c;        // второй конец капсулы
} pc;

float sd_box(vec3 p, vec3 h) {
    vec3 q = abs(p) - h;
    return length(max(q, vec3(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0);
}

float sd_sphere(vec3 p, float r) { return length(p) - r; }

float sd_capsule(vec3 p, vec3 a, vec3 b, float r) {
    vec3 pa = p - a;
    vec3 ba = b - a;
    float h = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-9), 0.0, 1.0);
    return length(pa - ba * h) - r;
}

float sd_cylinder_y(vec3 p, float r, float hh) {
    vec2 d = abs(vec2(length(p.xz), p.y)) - vec2(r, hh);
    return min(max(d.x, d.y), 0.0) + length(max(d, vec2(0.0)));
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint nx = pc.grid.x;
    uint ny = pc.grid.y;
    uint nz = pc.grid.z;
    if (i >= nx * ny * nz) {
        return;
    }
    uint x = i % nx;
    uint y = (i / nx) % ny;
    uint z = i / (nx * ny);
    vec3 p = pc.origin.xyz + vec3(x, y, z) * pc.origin.w;

    uint kind = pc.grid.w;
    float v;
    if (kind == 0u) {
        v = sd_box(p - pc.a.xyz, pc.b.xyz);
    } else if (kind == 1u) {
        v = sd_sphere(p - pc.a.xyz, pc.a.w);
    } else if (kind == 2u) {
        v = sd_capsule(p, pc.a.xyz, pc.c.xyz, pc.a.w);
    } else {
        v = sd_cylinder_y(p - pc.a.xyz, pc.a.w, pc.b.x);
    }
    d[i] = v;
}
