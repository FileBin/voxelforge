#version 450
#include "w_push.glsl"

layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Pos { vec4 pos[]; };
layout(std430, set = 0, binding = 1) buffer Prev { vec4 prev[]; };
layout(std430, set = 0, binding = 2) buffer Vel { vec4 vel[]; };
layout(std430, set = 0, binding = 3) buffer Counts { uint cnt[]; };
layout(std430, set = 0, binding = 4) buffer Buckets { uint items[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint n = uint(wp.prm2.x);
    if (i >= n) return;
    vec3 v = (pos[i].xyz - prev[i].xyz) / wp.prm0.x;

    /* Вязкость: подтягиваем скорость к соседям. Без неё вода «искрит». */
    float h = wp.prm0.y;
    vec3 pi = pos[i].xyz;
    ivec3 c = cell_of(pi, h);
    vec3 dv = vec3(0.0);
    for (int dz = -1; dz <= 1; dz++)
    for (int dy = -1; dy <= 1; dy++)
    for (int dx = -1; dx <= 1; dx++) {
        uint b = hash_cell(c + ivec3(dx, dy, dz));
        uint k = min(cnt[b], CAP);
        for (uint s = 0u; s < k; s++) {
            uint j = items[b * CAP + s];
            if (j == i) continue;
            float r = length(pos[j].xyz - pi);
            if (r >= h) continue;
            dv += (vel[j].xyz - v) * (1.0 - r / h);
        }
    }
    v += dv * wp.prm1.y * wp.prm0.x;

    if (pos[i].y <= wp.prm1.z + 0.041) {
        v.x *= 0.9;
        v.z *= 0.9;
    }
    vel[i] = vec4(v, 0.0);
}
