#version 450
#include "common.glsl"

/* Контакты со статикой — ПРОХОД 0 из 4: сброс свёрток по каналам.
 *
 * ПОЧЕМУ ИМЯ СТАРОЕ. Раньше этот файл был единственным проходом и делал всю
 * работу: ОДНА invocation на тело, внутри — цикл по всем тетам тела (у плиты
 * тысячи) и по 4 вершины на тет. Один поток обходил десятки тысяч вершин, при
 * 64 потоках в группе и десятках тел занята была ОДНА рабочая группа — 80 %
 * такта уходило в эту стадию при простое GPU.
 *
 * Теперь работа нарезана по ТЕТАМ (см. static_work.comp), и стадия состоит из
 * четырёх проходов:
 *   static_contacts (этот файл) — сброс свёрток, 8 каналов на тело;
 *   static_work   — тет считает локальные максимумы по 8 каналам;
 *   static_tie    — выбор победителя (минимальный индекс тета среди равных);
 *   static_emit   — на тело: точка победившего тета и push в прежнем порядке.
 *
 * Имя и номер стадии оставлены прежними намеренно: в таблице F3/VF_PERF=1
 * строка `static_contacts` показывает СУММУ всех четырёх проходов, поэтому
 * замеры «до/после» сравнимы напрямую.
 *
 * score = 0 — «кандидата нет» (кодирование static_work не даёт 0 для конечных
 * чисел), win = 0xFFFFFFFF — «победителя нет». Сброс — отдельным диспатчем, а
 * не записью с CPU: такт целиком уходит одним командным буфером, и хост-запись
 * между кусками такта недопустима.
 *
 * Буферы — 8 слотов на тело, размер по ЧИСЛУ ТЕЛ сцены (не по MAX_BODIES:
 * куча в тестах — 1000 и 5000 тел). CPU округляет размер до кратности 64,
 * поэтому диспатч покрывает буфер ровно и границы в шейдере не нужны.
 */

layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Score { uint score[]; };
layout(std430, set = 0, binding = 1) buffer Win { uint win[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    score[i] = 0u;
    win[i] = 0xFFFFFFFFu;
}
